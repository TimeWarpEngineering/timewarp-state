@namespace Sample06Wasm.Components
@inherits TracingComponent

@code {
  [Parameter] public string Label { get; set; } = "";
}

<article class="card" aria-labelledby="open-heading">
  <header class="card-head">
    <h3 id="open-heading">Open child</h3>
    <span class="badge">No parameter check</span>
  </header>
  <p>
    No parameter check. When <strong>Label</strong> changes, this child paints and the category is
    <code>Event</code>. The parameter is not named. An unchanged label does not paint it.
  </p>
  <p>Label <strong data-qa="open-label">@Label</strong></p>
  <RenderFacts
    RenderCount="RenderCount"
    Reason="RenderReason"
    Detail="@RenderReasonDetail"
    Caller="@RecordedCaller"
    Trace="Trace"
    QaPrefix="open-child" />
</article>
