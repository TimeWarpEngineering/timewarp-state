@namespace Sample06Wasm.Components
@inherits GuardedComponent

@code {
  [Parameter] public string Label { get; set; } = "";

  private string? AdmittedName { get; set; }

  private string? AdmitError { get; set; }

  // Razor rejects an attribute this component does not declare. The button builds a ParameterView
  // so HandleUnregisteredParameter can accept the extra name. Returning true paints and sets the detail.
  private async Task AdmitUnknown()
  {
    AdmitError = null;
    try
    {
      Dictionary<string, object?> parameters = new()
      {
        [nameof(Label)] = Label,
        ["Unknown"] = "admitted"
      };

      await SetParametersAsync(ParameterView.FromDictionary(parameters));
    }
    catch (Exception exception)
    {
      AdmitError = exception.Message;
    }
  }

  protected override bool HandleUnregisteredParameter(ParameterValue parameter)
  {
    AdmittedName = parameter.Name;
    return true;
  }
}

<article class="card" aria-labelledby="guarded-heading">
  <header class="card-head">
    <h3 id="guarded-heading">Guarded child</h3>
    <span class="badge">Primitive check</span>
  </header>
  <p>
    <code>GuardedComponent</code> overrides <code>CheckPrimitiveParameterChanged</code> and calls the base
    equality test. A changed <strong>Label</strong> records <code>ParameterChanged</code> and names the
    parameter. An unchanged label does not paint it.
  </p>
  <p>Label <strong data-qa="guarded-label">@Label</strong></p>
  <p>
    Last unregistered name
    <strong data-qa="admitted-name">@(AdmittedName ?? "none")</strong>
  </p>
  <p>
    Admit unknown parameter puts the name <code>Unknown</code> on a <code>ParameterView</code>.
    The hook records the reason. Blazor then refuses to assign a property this card does not have.
    The message under the button is that refusal, caught here.
  </p>
  <div class="row">
    <button type="button" class="ghost" @onclick="AdmitUnknown">Admit unknown parameter</button>
  </div>
  @if (AdmitError is not null)
  {
    <p data-qa="admit-error"><strong>Expected refusal.</strong> @AdmitError</p>
  }
  <RenderFacts
    RenderCount="RenderCount"
    Reason="RenderReason"
    Detail="@RenderReasonDetail"
    Caller="@RecordedCaller"
    Trace="Trace"
    QaPrefix="guarded-child" />
</article>
