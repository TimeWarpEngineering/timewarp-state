<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Sample04Server</AssemblyName>
    <RootNamespace>Sample04Server</RootNamespace>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Server-side Blazor is not trimmable. Package trim checks live in IsAotCompatible and the WASM PublishTrimmed smoke. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\source\timewarp-state\timewarp-state.csproj" />
    <ProjectReference Include="..\..\..\..\source\timewarp-state-blazor\timewarp-state-blazor.csproj" />
    <ProjectReference Include="..\..\..\..\source\timewarp-state-telemetry\timewarp-state-telemetry.csproj" />
    <ProjectReference Include="..\..\..\..\source\timewarp-state-analyzer\timewarp-state-analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\source\timewarp-state-source-generator\timewarp-state-source-generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\source\timewarp-state-devtools-export\timewarp-state-devtools-export.csproj" />
    <ProjectReference Include="..\..\wasm\sample-04-wasm\sample-04-wasm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TimeWarp.Mediator" />
    <PackageReference Include="TimeWarp.Mediator.Generators" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>
