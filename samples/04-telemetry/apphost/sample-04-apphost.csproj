<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Aspire 17 marks Aspire.AppHost.Sdk obsolete (ASPIRE012). The AppHost is a plain
    Microsoft.NET.Sdk project with explicit Aspire.Hosting.AppHost and Aspire.Hosting.Dotnet
    references. program.cs adds the server with AddDotnetProject, so there is no
    ProjectReference to it. why: task 164 2026-11-19
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <AssemblyName>Sample04AppHost</AssemblyName>
    <RootNamespace>Sample04AppHost</RootNamespace>
    <NoWarn>$(NoWarn);1591;CS8981</NoWarn>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\source\timewarp-state-devtools-hosting\timewarp-state-devtools-hosting.csproj" />
  </ItemGroup>

  <!-- In-repo import of the same targets the TimeWarp.State.DevTools.App package imports for consumers. ProjectReference does not flow that package's buildTransitive assets. -->
  <Import Project="..\..\..\source\timewarp-state-devtools-app\build\TimeWarp.State.DevTools.App.targets" />

</Project>
