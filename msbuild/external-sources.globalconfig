# Global analyzer config for compiled sources that live outside this repository.
#
# Some packages inject source files into the compilation from the NuGet cache (Fixie adds
# build/Fixie.Main.cs to every test project). The repo .editorconfig cannot reach paths
# outside the worktree. Restores in this repo use artifacts/nuget-packages, which is inside
# the worktree, so .editorconfig excludes that folder itself. This global config still covers
# a compile that resolves packages from a cache outside the worktree. Settings in
# .editorconfig take precedence over a global config, so the repo's own .cs files still get
# TWA0004 = error from .editorconfig.
is_global = true

dotnet_diagnostic.TWA0004.severity = none

# Razor files are additional files. The [*.razor] editorconfig section does not reach that
# compilation, so TWA0036 still warns there (task 132). These rules stay off for the same
# reason as in .editorconfig: only TWA0004 applies to this library. .editorconfig still wins
# for in-repo .cs files, including TWA0004 = error.
dotnet_diagnostic.TWA0026.severity = none
dotnet_diagnostic.TWA0027.severity = none
dotnet_diagnostic.TWA0028.severity = none
dotnet_diagnostic.TWA0032.severity = none
dotnet_diagnostic.TWA0033.severity = none
dotnet_diagnostic.TWA0034.severity = none
dotnet_diagnostic.TWA0036.severity = none
dotnet_diagnostic.TWA0037.severity = none
