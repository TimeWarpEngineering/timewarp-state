<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Client.Integration.Tests</AssemblyName>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fixie.TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TimeWarp.Fixie" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\test-app\test-app-client\test-app-client.csproj" />
    <ProjectReference Include="..\..\source\timewarp-state-source-generator\timewarp-state-source-generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Both hosts InternalsVisibleTo this assembly, so both internal AddGeneratedMediator
         extensions are visible (CS0121). The alias keeps the server extension out of scope.
         TimeWarp.Mediator 14.0.0-beta.4 release notes: a friend of two hosts still sees duplicates. -->
    <ProjectReference Include="..\test-app\test-app-server\test-app-server.csproj" Aliases="TestAppServer" />
  </ItemGroup>

</Project>
