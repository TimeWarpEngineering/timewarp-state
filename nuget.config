<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Local-feed restores stay in the worktree. A release version extracted here is not written to ~/.nuget/packages. -->
  <config>
    <add key="globalPackagesFolder" value="artifacts/nuget-packages" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalNuGetFeed" value="artifacts/packages" />
  </packageSources>
</configuration>