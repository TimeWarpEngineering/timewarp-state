<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restores stay in the worktree. A packed version extracted here is not written to ~/.nuget/packages.
       artifacts/packages is not a source, so a missing folder does not fail restore.
       The packaged consumer passes that folder as an explicit restore source. -->
  <config>
    <add key="globalPackagesFolder" value="artifacts/nuget-packages" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>