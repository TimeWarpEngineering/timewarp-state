<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>TimeWarp.State.Telemetry</Title>
    <Description>OpenTelemetry instrumentation for the TimeWarp.State mediator pipeline: action spans, timing, and opt-in AOT-safe state snapshots.</Description>
    <PackageId>TimeWarp.State.Telemetry</PackageId>
    <AssemblyName>TimeWarp.State.Telemetry</AssemblyName>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageTags>TimeWarp.State; TimeWarp-State; Telemetry; OpenTelemetry; OTel; Blazor; Aspire; Observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TimeWarp.Mediator.Contracts" />
    <PackageReference Include="TimeWarp.Mediator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\timewarp-state\timewarp-state.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimeWarp.State.Telemetry.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
