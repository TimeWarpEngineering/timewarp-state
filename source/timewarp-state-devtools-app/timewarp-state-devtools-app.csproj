<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>TimeWarp.State.DevTools.App</Title>
    <Description>Published TimeWarp DevTools inspector. Framework-dependent, no runtime identifier. Started by TimeWarp.State.DevTools.Hosting.</Description>
    <PackageId>TimeWarp.State.DevTools.App</PackageId>
    <AssemblyName>TimeWarp.State.DevTools.App</AssemblyName>
    <RootNamespace>TimeWarp.State.DevTools.App</RootNamespace>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageTags>TimeWarp.State; DevTools; Aspire</PackageTags>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes>
    <DevToolsProject>$(MSBuildThisFileDirectory)..\timewarp-state-devtools\timewarp-state-devtools.csproj</DevToolsProject>
    <DevToolsToolsDir Condition="'$(DevToolsToolsDir)' == ''">$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), 'tools'))</DevToolsToolsDir>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddDevToolsToolsToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- Private so the nupkg does not depend on the unpackable inspector project. The publish output under tools/ already contains those assemblies. -->
  <ItemGroup>
    <ProjectReference Include="$(DevToolsProject)">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="readme.md" Pack="true" PackagePath="\" />
    <!-- Full package path. A directory-only PackagePath is prefixed with this item's RecursiveDir (build\). -->
    <None Update="build\TimeWarp.State.DevTools.App.targets" Pack="true" PackagePath="build\TimeWarp.State.DevTools.App.targets" />
  </ItemGroup>

  <!--
    The ProjectReference builds the inspector with the solution's properties. Publish then copies
    that output. NoBuild keeps this invocation from compiling into the same obj folder under a
    second set of global properties. Pack publishes again after deleting tools/; DevToolsPackPublish
    is a distinct global property so the MSBuild task does not reuse this result.
  -->
  <Target Name="PublishDevToolsAppOnBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild
      Projects="$(DevToolsProject)"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
    <MSBuild
      Projects="$(DevToolsProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);SelfContained=false;UseAppHost=false;PublishDir=$(DevToolsToolsDir);NoBuild=true;BuildProjectReferences=false" />
  </Target>

  <!--
    NuGet reads TfmSpecificPackageFile from this target. A None item whose PackagePath uses
    %(RecursiveDir) is batched against the targets file already in None, which nests every
    published file under that targets path.
  -->
  <Target Name="AddDevToolsToolsToPackage" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(DevToolsToolsDir)" />
    <MSBuild
      Projects="$(DevToolsProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);SelfContained=false;UseAppHost=false;PublishDir=$(DevToolsToolsDir);NoBuild=true;BuildProjectReferences=false;DevToolsPackPublish=true" />
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)build\TimeWarp.State.DevTools.App.targets"
      DestinationFiles="$(IntermediateOutputPath)TimeWarp.State.DevTools.App.targets" />
    <ItemGroup>
      <_DevToolsPublishedFile Include="$(DevToolsToolsDir)**\*.*" />
      <!-- Run mode sets ASPNETCORE_ENVIRONMENT=Development on the executable. These files are not that switch. Pdbs stay. -->
      <_DevToolsPublishedFile Remove="$(DevToolsToolsDir)**\appsettings.Development.json;$(DevToolsToolsDir)**\tsconfig.json;$(DevToolsToolsDir)**\web.config;$(DevToolsToolsDir)**\*.xml" />
    </ItemGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(IntermediateOutputPath)TimeWarp.State.DevTools.App.targets">
        <PackagePath>buildTransitive\TimeWarp.State.DevTools.App.targets</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="@(_DevToolsPublishedFile)">
        <PackagePath>tools\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
