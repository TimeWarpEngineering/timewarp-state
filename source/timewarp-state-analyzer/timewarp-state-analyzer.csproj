<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <OutputPath>$(ArtifactsDirectory)analyzers\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the Roslyn floor. PrivateAssets stops this from flowing through ProjectReference into TimeWarp.State. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared fact extractors: the State generator's per-symbol rules compiled into the analyzer as linked source,
         so the analyzer and the generator cannot drift (task 142). Listed one by one, not facts\*.cs, so a future
         generator-only file in that folder is not linked into the analyzer by accident. -->
    <Compile Include="..\timewarp-state-source-generator\facts\catalog-action-facts.cs" Link="facts\catalog-action-facts.cs" />
    <Compile Include="..\timewarp-state-source-generator\facts\state-symbol-facts.cs" Link="facts\state-symbol-facts.cs" />
  </ItemGroup>

</Project>
