<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Title>TimeWarp.State.Plus</Title>
    <Description>TimeWarp.State.Plus extends TimeWarp.State and TimeWarp.State.Blazor with routing, persistence, and action tracking.</Description>
    <PackageId>TimeWarp.State.Plus</PackageId>
    <IsPackable>true</IsPackable>
    <PackageTags>TimeWarp-State; TimeWarpState; BlazorState; Blazor; State; Blazor-State; TimeWarp.Mediator; Mediator; Pipeline; Middleware; Redux; Flux; Features; Plus</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Trim and AOT analysis">
    <!-- Plus ships in trimmed Blazor WebAssembly apps. IL2xxx/IL3xxx are errors. Reflection that remains
         (persistence JSON, PersistentStateAttribute lookup, cache-key serialization) is suppressed in place. -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2055;IL2057;IL2058;IL2059;IL2060;IL2061;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2103;IL2104;IL2111;IL3050;IL3051;IL3056</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <!-- UsedImplicitly is a design-time attribute. PrivateAssets keeps it out of the packed dependency list. -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all"/>
    <PackageReference Include="Blazored.SessionStorage"/>
    <PackageReference Include="Blazored.LocalStorage"/>
    <!-- Contracts flow transitively from TimeWarp.State; the analyzer package is build-only. -->
    <PackageReference Include="TimeWarp.Mediator.Analyzers" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\timewarp-state\timewarp-state.csproj"/>
    <ProjectReference Include="..\timewarp-state-blazor\timewarp-state-blazor.csproj"/>
    <ProjectReference Include="..\timewarp-state-source-generator\timewarp-state-source-generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\timewarp-state-analyzer\timewarp-state-analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimeWarp.State.Plus.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <None Include=".\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
