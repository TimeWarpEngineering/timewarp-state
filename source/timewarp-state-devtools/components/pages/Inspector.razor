@namespace TimeWarp.State.DevTools.Components.Pages
@page "/"
@rendermode InteractiveServer
@inherits TimeWarpStateComponent

@code {
  [Inject] private InspectorLog InspectorLog { get; set; } = null!;
  [Inject] private InspectorManifest InspectorManifest { get; set; } = null!;
  [Inject] private ILogger<Inspector> Logger { get; set; } = null!;

  // Set once by Dispose; the log's Changed event can fire on an ingest thread after that.
  private int Disposed;

  private InspectorState InspectorState => GetState<InspectorState>();

  protected override void OnInitialized()
  {
    InspectorLog.Changed += OnLogChanged;
    InspectorManifest.Changed += OnLogChanged;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (!firstRender)
    {
      return;
    }

    // A reconnected circuit starts from default state while <html data-theme> keeps the old value.
    await InspectorState.SetTheme(InspectorState.Theme);
  }

  private void OnLogChanged()
  {
    if (Volatile.Read(ref Disposed) != 0)
    {
      return;
    }

    _ = SyncLogSafeAsync();
  }

  private async Task SyncLogSafeAsync()
  {
    try
    {
      await InvokeAsync(SyncLogAsync);
    }
    catch (Exception exception) when (exception is ObjectDisposedException or InvalidOperationException)
    {
      // The circuit ended between the event and the dispatch. Nothing left to refresh.
    }
    catch (Exception exception)
    {
      // Fire-and-forget: observe the fault here so it is never an unobserved task exception.
      // The next Changed event retries, so the page stays up.
      Logger.LogError(exception, "Refreshing the inspector after an action log change failed.");
    }
  }

  private Task SyncLogAsync() => InspectorState.NoteLogChanged();

  private Task CycleTheme() => InspectorState.CycleTheme();

  private Task SetTab(string tab) => InspectorState.SetDetailTab(tab);

  public override void Dispose()
  {
    if (Interlocked.Exchange(ref Disposed, 1) != 0)
    {
      return;
    }

    InspectorLog.Changed -= OnLogChanged;
    InspectorManifest.Changed -= OnLogChanged;
    base.Dispose();
  }
}

<PageTitle>TimeWarp DevTools</PageTitle>

<div class="app">
  <header class="mast">
    <div class="mast-top">
      <h1 data-qa="brand">TimeWarp DevTools</h1>
      <button type="button" class="theme" @onclick="CycleTheme" data-qa="theme">Theme: @InspectorViewHelper.ThemeLabel(InspectorState.Theme)</button>
    </div>
    <div class="plugin-row">
      <nav class="plugins" aria-label="Plugins">
        <span class="plugin" aria-current="page" data-qa="plugin">State</span>
      </nav>
      <p class="lede">Current state, and the action that produced it.</p>
    </div>
  </header>

  @{
    InspectorView view = InspectorView.Create(InspectorLog, InspectorState);
  }
  <InspectorToolbar InspectorState="InspectorState" Paused="InspectorLog.IsPaused" Count="view.Entries.Count" />

  <div class="workspace">
    <ActionLogList InspectorState="InspectorState" Entries="view.Entries" />

    <section class="detail" aria-label="State" data-qa="detail">
      <TabStrip Tabs="InspectorViewHelper.DetailTabs" Current="@InspectorState.DetailTab" OnSelect="SetTab" />

      @if (InspectorState.DetailTab == InspectorState.DetailTabAction)
      {
        <ActionDetail Selected="view.Selected" />
      }
      else if (InspectorState.DetailTab == InspectorState.DetailTabDiff)
      {
        <DiffPanel InspectorState="InspectorState" SelectedDiff="view.SelectedDiff" />
      }
      else if (InspectorState.DetailTab == InspectorState.DetailTabManifest)
      {
        <ManifestPanel Manifests="InspectorManifest.Snapshot()" />
      }
      else
      {
        <StatePanel InspectorState="InspectorState" View="view" />
      }
    </section>
  </div>
</div>
