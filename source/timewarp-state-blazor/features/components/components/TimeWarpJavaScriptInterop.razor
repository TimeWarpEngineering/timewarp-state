@namespace TimeWarp.Features.JavaScriptInterop

@code {
#region Purpose
  // Registers JsonRequestHandler with window.TimeWarpState once per circuit.
#endregion

#region Design
  // InitAsync runs only on firstRender. Repeating it on every render would replace
  // the DotNetObjectReference while JS may already be dispatching.
#endregion

  [Inject] private JsonRequestHandler JsonRequestHandler { get; set; } = null!;

  /// <inheritdoc/>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await JsonRequestHandler.InitAsync();
    }
    await base.OnAfterRenderAsync(firstRender);
  }
}
