<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>TimeWarp.State.DevTools.Hosting</Title>
    <Description>Aspire hosting integration that adds the TimeWarp.State DevTools app and links it from the dashboard.</Description>
    <PackageId>TimeWarp.State.DevTools.Hosting</PackageId>
    <AssemblyName>TimeWarp.State.DevTools.Hosting</AssemblyName>
    <RootNamespace>TimeWarp.State.DevTools.Hosting</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageTags>TimeWarp.State; DevTools; Aspire; Hosting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimeWarp.State.DevTools.Tests" />
  </ItemGroup>

  <!--
    NuGet restore omits a project reference whose ReferenceOutputAssembly is false, so the
    packed nuspec would not depend on TimeWarp.State.DevTools.App. Leave the reference on.
    Hosting source does not use that assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\timewarp-state-devtools-app\timewarp-state-devtools-app.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
