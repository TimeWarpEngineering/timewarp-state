<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- TimeWarp Packages -->
    <!-- TimeWarp pins below were brought current by the ganda repo audit fix. why: task 156, 2026-11-16 -->
    <PackageVersion Include="TimeWarp.Amuru" Version="3.0.0-beta.5" />
    <PackageVersion Include="TimeWarp.Amuru.Tools" Version="3.0.0-beta.5" />
    <PackageVersion Include="TimeWarp.Build.Tasks" Version="2.0.1-beta.1" />
    <PackageVersion Include="TimeWarp.Fixie" Version="3.1.0" />
    <PackageVersion Include="TimeWarp.Mediator" Version="15.0.0-beta.9" />
    <PackageVersion Include="TimeWarp.Mediator.Generators" Version="15.0.0-beta.9" />
    <PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.14" />
    <PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.14" />
    <PackageVersion Include="TimeWarp.SourceGenerators" Version="1.0.0-beta.16" />
    <PackageVersion Include="TimeWarp.State" Version="$(TimeWarpStateVersion)" />
    <PackageVersion Include="TimeWarp.State.Blazor" Version="$(TimeWarpStateVersion)" />
    <PackageVersion Include="TimeWarp.Terminal" Version="2.0.0-beta.2" />
    <PackageVersion Include="timewarp-heroicons" Version="2.2.0" />

    <!-- Microsoft ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />

    <!-- Microsoft Code Analysis -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <!-- Analyzer and source generator compile against this Roslyn, so it is the consumer compiler floor.
         5.12.0 loads on .NET SDK 11.0.100 (GA) and later, which bundles Roslyn 5.12.0 (checked from the SDK's
         Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll; SDK 10.0.404 bundles 5.9). The packages target net11.0, so a
         .NET 11 SDK is already required. .NET 11 preview / RC SDKs with an older Roslyn are not supported (task 157).
         Those projects mark the reference PrivateAssets so it is not a package dependency. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <!-- Code fixes compile against the same Roslyn floor as the analyzer. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />

    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0" />
    <!-- Direct pin for timewarp-state-analyzer-tests: NuGet.Packaging 7.0.3 (via Analyzer.Testing 1.1.4) pulls 9.0.6,
         which has NU1902/NU1903 advisories that fail the build under TreatWarningsAsErrors. why: task 148 2026-11-07 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />

    <!-- Microsoft Testing & Build Tools -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- v4 is the MSTest 4 build of Playwright. Microsoft.Playwright.MSTest 1.63.0 still binds the MSTest 3 assembly. -->
    <PackageVersion Include="Microsoft.Playwright.MSTest.v4" Version="1.64.1" />
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" />

    <!-- Testing Frameworks -->
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Fixie.TestAdapter" Version="4.2.0" />
    <!-- Paired with Microsoft.Playwright.MSTest.v4. The non-v4 Playwright.MSTest package binds the MSTest 3 assembly identity. -->
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <!-- 4.3.0 is the latest stable. 5.0.0-preview.2 drops params overloads such as ShouldBeOneOf; the stable-band outdated tool does not select it. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />

    <!-- Blazor Storage -->
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageVersion Include="Blazored.SessionStorage" Version="2.4.0" />

    <!-- OpenTelemetry / Aspire (telemetry sample) -->
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />

    <!-- System & Utilities -->
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
  </ItemGroup>
</Project>
